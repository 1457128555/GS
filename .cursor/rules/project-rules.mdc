## 开发规范

### 1. 创建新 Actor

```typescript
// 1. 在 src/actor/ 下创建文件
// 2. 继承 Actor 或 RoleActor
import { Actor } from '../core/Actor';

export class MyActor extends Actor {
    protected mCustomProperty: number = 0;  // 使用 m 前缀

    override initFromData(properties: Record<string, any>): void {
        super.initFromData(properties);
        if ('customProperty' in properties)
            this.mCustomProperty = properties.customProperty;
    }

    protected override onAttach(): void {
        // 挂载时调用
    }

    protected override onUpdate(dt: number): void {
        // 每帧更新
    }

    protected override onDetach(): void {
        // 移除时调用
    }
}

// 3. 在 RegisterTypes.ts 中注册
TypeRegistry.registerActor('MyActor', MyActor);
```

### 2. 创建新 Component

```typescript
// 1. 在 src/component/ 下创建文件
// 2. 继承 Component
import { Component } from '../core/Component';

export class MyComp extends Component {
    protected mValue: string = '';

    override initFromData(properties: Record<string, any>): void {
        super.initFromData(properties);
        if ('value' in properties)
            this.mValue = properties.value;
    }

    protected override onAttach(): void {
        // 挂载到 Actor 时调用，this.parent 可用
    }

    protected override onUpdate(dt: number): void {
        // 每帧更新
    }

    protected override onDetach(): void {
        // 从 Actor 移除时调用
    }
}

// 3. 在 RegisterTypes.ts 中注册
TypeRegistry.registerComponent('MyComp', MyComp);
```

### 3. JSON 配置格式

**Actor 配置文件** (`public/actors/xxx.json`)：

```json
{
    "type": "MyActor",
    "properties": {
        "name": "实体名称",
        "position": { "x": 100, "y": 200 },
        "customProperty": 42
    },
    "components": [
        {
            "type": "MyComp",
            "name": "组件名称",
            "properties": {
                "value": "hello"
            }
        }
    ],
    "children": [
        {
            "path": "/actors/other.json",
            "override": { "name": "覆盖的名称" }
        }
    ]
}
```

